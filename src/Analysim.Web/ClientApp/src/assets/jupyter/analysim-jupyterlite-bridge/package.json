{
  "name": "@analysim/jupyterlite-bridge",
  "version": "0.1.0",
  "description": "AnalySim postMessage bridge for embedded JupyterLite",
  "private": true,
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "node ../../../../scripts/setup-jupyterlite-venv.js && node ../../../../scripts/build-jupyterlite-extension.js",
    "copy:jupyterlite-extension": "node scripts/copy-extension.js"
  },
  "dependencies": {
    "@jupyterlab/application": "4.5.1"
  },
  "devDependencies": {
    "@jupyterlab/builder": "4.5.1",
    "typescript": "~5.2.2"
  },
  "overrides": {
    "@jupyterlab/application": "4.5.1",
    "@jupyterlab/apputils": "4.6.1",
    "@jupyterlab/coreutils": "6.5.1",
    "@jupyterlab/docregistry": "4.5.1",
    "@jupyterlab/notebook": "4.5.1",
    "@jupyterlab/rendermime": "4.5.1",
    "@jupyterlab/translation": "4.5.1",
    "@jupyterlab/ui-components": "4.5.1",
    "@lumino/coreutils": "2.2.2",
    "@lumino/widgets": "2.7.2",
    "webpack": "5.94.0"
  },
  "jupyterlab": {
    "extension": true,
    "outputDir": "labextension"
  }
}

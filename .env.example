COMPOSE_PROJECT_NAME=analysim
ANALYSIM_DATA_ROOT=/media/volume/Analysim-Data
ANALYSIM_DOMAIN=dev.analysim.tech
ANALYSIM_IMAGE_TAG=latest
TLS_CERT_PATH=/etc/letsencrypt/live/dev.analysim.tech/fullchain.pem
TLS_KEY_PATH=/etc/letsencrypt/live/dev.analysim.tech/privkey.pem
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=30
